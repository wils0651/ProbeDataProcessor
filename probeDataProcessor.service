# /etc/systemd/system/probeDataProcessor.service
[Unit]
Description=Probe Data Processor - Process Temperature Probe Data
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/apps/ProbeDataProcessor
ExecStart=/usr/bin/dotnet /opt/apps/ProbeDataProcessor/ProbeDataProcessor.dll ProcessTemperatureData
User=tim
Environment=APP_ENV=Production
SyslogIdentifier=probeDataProcessor
KillSignal=SIGINT
StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=multi-user.target

